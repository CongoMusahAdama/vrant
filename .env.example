# Website (Vite) — copy to .env for local development.
# On Vercel, add these under Project → Settings → Environment Variables.
# Only VITE_ values go here and they are PUBLIC in the browser — never put secrets in this file.

# Public site URL, used for image links in WhatsApp messages (e.g. https://vrant.com)
VITE_SITE_URL=

# WhatsApp number for checkout & support — country code, no + or spaces
VITE_WHATSAPP_NUMBER=233200906851
