# VRANT API — copy to backend/.env for local development.
# In production these go in Vercel → Project → Settings → Environment Variables. Never commit real values.

NODE_ENV=development
PORT=5000
# The website URL (e.g. https://vrant.com) — used for payment redirects and reset links
FRONTEND_URL=http://localhost:8080
# Extra allowed origins, comma-separated (custom domain, www, Vercel previews)
CORS_ORIGINS=
# Customer-facing domain for email/SMS links, if different from FRONTEND_URL
PUBLIC_SITE_URL=

MONGODB_URI=
# At least 16 random characters (production refuses to start otherwise)
JWT_SECRET=
JWT_EXPIRE=7d

# Used by `node scripts/ensureAdmin.js` to create/reset the admin login
ADMIN_EMAIL=
ADMIN_PASSWORD=
ALLOW_ADMIN_SETUP=false

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# pk_test_/sk_test_ while testing, pk_live_/sk_live_ when live (must match)
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=VRANT

MNOTIFY_API_KEY=
MNOTIFY_SENDER_ID=VRANT

ADMIN_NOTIFY_EMAIL=
ADMIN_NOTIFY_PHONE=0200906851
